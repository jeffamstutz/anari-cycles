{
 "info": {
  "name": "KHR_CAMERA_OMNIDIRECTIONAL",
  "type": "extension",
  "dependencies": [],
  "comment": "Local copy of the ANARI registry extension. The registry file also declares 'imageRegion', which this device does not implement on any camera subtype yet, so it is omitted here. Keep info.name equal to the official extension name so introspection still advertises it."
 },
 "objects": [
  {
   "type": "ANARI_CAMERA",
   "name": "omnidirectional",
   "description": "omnidirectional camera object",
   "parameters": [
    {
     "name": "name",
     "types": [
      "ANARI_STRING"
     ],
     "tags": [],
     "description": "optional object name"
    },
    {
     "name": "position",
     "types": [
      "ANARI_FLOAT32_VEC3"
     ],
     "tags": [
      "point"
     ],
     "default": [
      0.0,
      0.0,
      0.0
     ],
     "description": "camera position"
    },
    {
     "name": "direction",
     "types": [
      "ANARI_FLOAT32_VEC3"
     ],
     "tags": [
      "direction"
     ],
     "default": [
      0.0,
      0.0,
      -1.0
     ],
     "description": "main viewing direction"
    },
    {
     "name": "up",
     "types": [
      "ANARI_FLOAT32_VEC3"
     ],
     "tags": [
      "direction"
     ],
     "default": [
      0.0,
      1.0,
      0.0
     ],
     "description": "camera up direction"
    },
    {
     "name": "layout",
     "types": [
      "ANARI_STRING"
     ],
     "tags": [],
     "default": "equirectangular",
     "values": [
      "equirectangular"
     ],
     "description": "pixel layout"
    }
   ]
  }
 ]
}
