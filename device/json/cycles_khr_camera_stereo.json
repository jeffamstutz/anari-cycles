{
 "info": {
  "name": "KHR_CAMERA_STEREO",
  "type": "extension",
  "dependencies": [],
  "comment": "Local copy of the ANARI registry extension. The registry file attaches the parameters to an ANARI_CAMERA named 'default'; instead they are declared here on the camera subtypes this device actually exposes. 'stereoMode' is trimmed to single-eye rendering: 'sideBySide' and 'topBottom' would need two render passes (or per-eye imageRegion support) composited into one frame, which this device cannot do yet; they warn and fall back to 'none'."
 },
 "objects": [
  {
   "type": "ANARI_CAMERA",
   "name": "perspective",
   "parameters": [
    {
     "name": "stereoMode",
     "types": [
      "ANARI_STRING"
     ],
     "tags": [],
     "default": "none",
     "values": [
      "none",
      "left",
      "right"
     ],
     "description": "stereo mode"
    },
    {
     "name": "interpupillaryDistance",
     "types": [
      "ANARI_FLOAT32"
     ],
     "tags": [],
     "default": 0.0635,
     "description": "interpupillary distance for stereo rendering"
    }
   ]
  },
  {
