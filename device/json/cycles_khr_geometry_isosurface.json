{
    "info" : {
        "name" : "KHR_GEOMETRY_ISOSURFACE",
        "type" : "extension",
        "dependencies" : [],
        "comment" : "Local copy of the ANARI registry extension. All parameters are implemented by anari-cycles: the shells are extracted into a triangle mesh by marching cubes at commit time (Cycles cannot ray-trace implicit isosurfaces), so surface positions/normals are voxel-resolution approximations. One ANARI primitive per isovalue: 'primitive.*' arrays and 'primitive.id' are indexed by isovalue index, and 'primitive.id' values are stored as float32 Cycles attributes (exact below 2^24). The 'field' must provide dense voxel access (structuredRegular). Keep info.name equal to the official extension name so introspection advertises it."
    },

    "objects" : [
        {
            "type" : "ANARI_GEOMETRY",
            "name" : "isosurface",
            "description" : "isosurface geometry object",
            "parameters" : [
