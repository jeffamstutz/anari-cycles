{
  "info": {
    "name": "CYCLES_DEVICE",
    "type": "device",
    "comment": [
      "Dependency stems prefixed with 'cycles_' resolve to trimmed local",
      "copies in device/json/ (see CMakeLists.txt JSON_ROOT_LOCATION).",
      "They advertise the official KHR extension names but omit registry",
      "parameters this device does not implement yet.",
      "khr_frame_channel_object_id must stay listed after",
      "khr_volume_transfer_function1d: its anonymous ANARI_VOLUME 'id' entry",
      "only merges into subtypes that already exist."
    ],
    "dependencies": [
      "anari_core_1_0",
      "anari_core_objects_base_1_0",
      "cycles_khr_camera_orthographic",
      "cycles_khr_camera_perspective",
      "cycles_khr_geometry_quad",
      "cycles_khr_geometry_sphere",
      "cycles_khr_geometry_triangle",
      "cycles_khr_instance_transform",
      "cycles_khr_instance_transform_array",
      "cycles_khr_sampler_image1d",
      "khr_device_synchronization",
      "khr_frame_accumulation",
      "khr_frame_channel_albedo",
      "khr_frame_channel_normal",
      "khr_light_directional",
      "khr_light_hdri",
      "khr_light_point",
      "khr_light_quad",
      "khr_light_spot",
      "cycles_khr_renderer_ambient_light",
      "khr_material_matte",
      "cycles_khr_material_physically_based",
      "khr_renderer_background_color",
      "khr_renderer_denoise",
      "khr_sampler_image2d",
      "khr_spatial_field_structured_regular",
      "khr_volume_transfer_function1d",
      "khr_frame_channel_object_id"
    ]
  },
  "objects": [
    {
      "type": "ANARI_RENDERER",
      "name": "default",
      "parameters": [
        {
          "name": "pixelSamples",
          "types": [
            "ANARI_INT32"
          ],
          "tags": [],
          "default": [
            1
          ],
          "description": "samples accumulated per anariRenderFrame() call"
        },
        {
          "name": "runAsync",
          "types": [
            "ANARI_BOOL"
          ],
          "tags": [],
          "default": [
            true
          ],
          "description": "run anariRenderFrame() asynchronously"
        }
      ]
    }
  ]
}
